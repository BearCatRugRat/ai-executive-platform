<Window x:Class="Aep.CommandCenter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Aep.CommandCenter" Title="AI Executive Platform" Height="820" Width="1320" Background="#0B1220" Foreground="White">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <local:SeverityToBrushConverter x:Key="SeverityToBrush"/>
    <local:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis"/>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <StackPanel>
          <TextBlock Text="AI Executive Platform" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="Executive Command Center" FontSize="16" Foreground="#9FB3C8"/>
        </StackPanel>
        <Button Content="?" Width="28" Height="28" Margin="12,0,0,0" Padding="0" FontWeight="Bold"
                Background="#2A3A55" Foreground="White" BorderThickness="0" VerticalAlignment="Top"
                ToolTip="What is this console? Click for an overview of every section."
                Command="{Binding ShowHelpCommand}" CommandParameter="overview"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Dev Catch-Up" Padding="16,8" Margin="0,0,10,0" VerticalAlignment="Center"
              Background="#2F6FED" Foreground="White" BorderThickness="0" Command="{Binding DevCatchUpCommand}"
              ToolTip="Opens a Claude Code session on C:\Development with the catch-up prompt pre-filled - press Enter in the new window to actually start it (Claude Desktop never auto-sends a deep-linked prompt)"/>
      <Button Grid.Column="2" Content="Cowork Catch-Up" Padding="16,8" Margin="0,0,10,0" VerticalAlignment="Center"
              Background="#2F9E6F" Foreground="White" BorderThickness="0" Command="{Binding CoworkCatchUpCommand}"
              ToolTip="Opens a Claude Cowork session with both repos attached, pre-filled to run the brian-catchup skill - press Enter in the new window to send it"/>
      <Button Grid.Column="3" Content="Reload" Padding="16,8" Margin="0,0,10,0" VerticalAlignment="Center" Command="{Binding ReloadCommand}"/>
    </Grid>

    <Border Grid.Row="1" Margin="0,18,0,18" Padding="18" Background="#142033" CornerRadius="10">
      <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="#C5D2E0" TextWrapping="Wrap"/>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Text="Module Status" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Content="?" Width="20" Height="20" Margin="8,0,0,0" Padding="0" FontSize="11" FontWeight="Bold"
                  Background="#2A3A55" Foreground="White" BorderThickness="0" VerticalAlignment="Center"
                  Command="{Binding ShowHelpCommand}" CommandParameter="module-status"/>
        </StackPanel>
        <TextBlock Text="Live from each domain app's own API - not the governance log." FontSize="11"
                    Foreground="#6B7A90" Margin="0,-6,0,10"/>
        <ItemsControl ItemsSource="{Binding ModuleStatuses}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="#9FB3C8" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Cards}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Width="300" Margin="0,0,14,14" Padding="16" Background="#1B2A44" CornerRadius="10"
                              BorderThickness="0,0,0,4" BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                        <StackPanel>
                          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"/>
                          <TextBlock Text="{Binding Headline}" FontSize="13" Foreground="#C5D2E0" Margin="0,6,0,0" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#8FA0B8" Margin="0,6,0,0" TextWrapping="Wrap"
                                      Visibility="{Binding Detail, Converter={StaticResource NullOrEmptyToVis}}"/>
                          <Button Content="Go deeper" Padding="12,5" Margin="0,12,0,0" HorizontalAlignment="Left" FontSize="11"
                                  Background="#3A4A66" Foreground="White" BorderThickness="0"
                                  ToolTip="Opens a Claude session pre-scoped to this card's topic"
                                  Command="{Binding DataContext.LaunchModuleCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,10">
          <TextBlock Text="Domain Applications" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Content="?" Width="20" Height="20" Margin="8,0,0,0" Padding="0" FontSize="11" FontWeight="Bold"
                  Background="#2A3A55" Foreground="White" BorderThickness="0" VerticalAlignment="Center"
                  Command="{Binding ShowHelpCommand}" CommandParameter="domain-applications"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding DomainApplications}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="280" Margin="0,0,14,14" Padding="16" Background="#1B2A44" CornerRadius="10">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#7FD1AE" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding NextAction}" FontSize="12" Foreground="#9FB3C8" Margin="0,8,0,0" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                              Visibility="{Binding HasRepoPath, Converter={StaticResource BoolToVis}}">
                    <Button Content="Open" Padding="14,6" Margin="0,0,8,0" Background="#2F6FED" Foreground="White" BorderThickness="0"
                            ToolTip="Use this app - opens it for real work, not development"
                            Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                    <Button Content="Develop" Padding="14,6" Background="#3A4A66" Foreground="White" BorderThickness="0"
                            ToolTip="Work on the code - opens a Claude Code session scoped to this repo"
                            Command="{Binding DataContext.DevelopProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,10">
          <TextBlock Text="Command Center Areas" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Content="?" Width="20" Height="20" Margin="8,0,0,0" Padding="0" FontSize="11" FontWeight="Bold"
                  Background="#2A3A55" Foreground="White" BorderThickness="0" VerticalAlignment="Center"
                  Command="{Binding ShowHelpCommand}" CommandParameter="command-center-areas"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding CommandCenterAreas}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="230" Margin="0,0,12,12" Padding="14" Background="#16223A" CornerRadius="10">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#9FB3C8" Margin="0,4,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                              Visibility="{Binding HasRepoPath, Converter={StaticResource BoolToVis}}">
                    <Button Content="Open" Padding="10,4" Margin="0,0,6,0" FontSize="11" Background="#2F6FED" Foreground="White" BorderThickness="0"
                            Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                    <Button Content="Develop" Padding="10,4" FontSize="11" Background="#3A4A66" Foreground="White" BorderThickness="0"
                            Command="{Binding DataContext.DevelopProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,10">
          <TextBlock Text="Software Projects" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Content="?" Width="20" Height="20" Margin="8,0,0,0" Padding="0" FontSize="11" FontWeight="Bold"
                  Background="#2A3A55" Foreground="White" BorderThickness="0" VerticalAlignment="Center"
                  Command="{Binding ShowHelpCommand}" CommandParameter="software-projects"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding SoftwareProjects}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Padding="12" Background="#111A2C" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" Width="220" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Status}" Width="90" Foreground="#7FD1AE"/>
                  <TextBlock Text="{Binding CurrentPhase}" Width="280" Foreground="#C5D2E0" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding NextAction}" Foreground="#9FB3C8" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,10">
          <TextBlock Text="Open Actions" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Content="?" Width="20" Height="20" Margin="8,0,0,0" Padding="0" FontSize="11" FontWeight="Bold"
                  Background="#2A3A55" Foreground="White" BorderThickness="0" VerticalAlignment="Center"
                  Command="{Binding ShowHelpCommand}" CommandParameter="open-actions"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding OpenActions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,6" Padding="10" Background="#111A2C" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Priority}" Width="70" Foreground="#E0A458" FontWeight="Bold"/>
                  <TextBlock Text="{Binding Action}" Foreground="#C5D2E0" TextWrapping="Wrap" Width="820"/>
                  <TextBlock Text="{Binding Owner}" Foreground="#9FB3C8" Margin="12,0,0,0"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
