<Window x:Class="Aep.CommandCenter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI Executive Platform" Height="820" Width="1320" Background="#0B1220" Foreground="White">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="AI Executive Platform" FontSize="30" FontWeight="Bold"/>
        <TextBlock Text="Executive Command Center" FontSize="16" Foreground="#9FB3C8"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Dev Catch-Up" Padding="16,8" Margin="0,0,10,0" VerticalAlignment="Center"
              Background="#2F6FED" Foreground="White" BorderThickness="0" Command="{Binding DevCatchUpCommand}"
              ToolTip="Opens a Claude Code session on C:\Development with the catch-up prompt pre-filled - press Enter in the new window to actually start it (Claude Desktop never auto-sends a deep-linked prompt)"/>
      <Button Grid.Column="2" Content="Reload" Padding="16,8" VerticalAlignment="Center" Command="{Binding ReloadCommand}"/>
    </Grid>

    <Border Grid.Row="1" Margin="0,18,0,18" Padding="18" Background="#142033" CornerRadius="10">
      <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="#C5D2E0" TextWrapping="Wrap"/>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <TextBlock Text="Domain Applications" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding DomainApplications}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="280" Margin="0,0,14,14" Padding="16" Background="#1B2A44" CornerRadius="10">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#7FD1AE" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding NextAction}" FontSize="12" Foreground="#9FB3C8" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Command Center Areas" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,10"/>
        <ItemsControl ItemsSource="{Binding CommandCenterAreas}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="230" Margin="0,0,12,12" Padding="14" Background="#16223A" CornerRadius="10">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#9FB3C8" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Software Projects" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,10"/>
        <ItemsControl ItemsSource="{Binding SoftwareProjects}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Padding="12" Background="#111A2C" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" Width="220" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Status}" Width="90" Foreground="#7FD1AE"/>
                  <TextBlock Text="{Binding CurrentPhase}" Width="280" Foreground="#C5D2E0" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding NextAction}" Foreground="#9FB3C8" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Open Actions" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,10"/>
        <ItemsControl ItemsSource="{Binding OpenActions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,6" Padding="10" Background="#111A2C" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Priority}" Width="70" Foreground="#E0A458" FontWeight="Bold"/>
                  <TextBlock Text="{Binding Action}" Foreground="#C5D2E0" TextWrapping="Wrap" Width="820"/>
                  <TextBlock Text="{Binding Owner}" Foreground="#9FB3C8" Margin="12,0,0,0"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
