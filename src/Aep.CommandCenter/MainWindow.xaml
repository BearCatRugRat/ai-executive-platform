<Window x:Class="Aep.CommandCenter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Aep.CommandCenter" Title="AI Executive Platform" Height="820" Width="1320" Background="#0B1220" Foreground="White">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <local:SeverityToBrushConverter x:Key="SeverityToBrush"/>
    <local:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis"/>
    <local:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <StackPanel>
          <TextBlock Text="AI Executive Platform" FontSize="30" FontWeight="Bold"/>
          <TextBlock Text="Executive Command Center" FontSize="16" Foreground="#9FB3C8"/>
        </StackPanel>
        <Button Content="?" Width="28" Height="28" Margin="12,0,0,0" Padding="0" FontWeight="Bold"
                Background="#2A3A55" Foreground="White" BorderThickness="0" VerticalAlignment="Top"
                ToolTip="What is this console? Click for an overview."
                Command="{Binding ShowHelpCommand}" CommandParameter="overview"/>
      </StackPanel>
      <Button Grid.Column="1" Content="Reload" Padding="16,8" VerticalAlignment="Center" Command="{Binding ReloadCommand}"/>
    </Grid>

    <Border Grid.Row="1" Margin="0,18,0,18" Padding="18" Background="#142033" CornerRadius="10">
      <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="#C5D2E0" TextWrapping="Wrap"/>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- Row 1: start the day - not part of the domain tree, always available -->
        <TextBlock Text="Start the day" FontSize="14" FontWeight="SemiBold" Foreground="#9FB3C8" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
          <Button Padding="16,10" Margin="0,0,14,0" Background="#2F6FED" Foreground="White" BorderThickness="0"
                  Command="{Binding DevCatchUpCommand}"
                  ToolTip="Opens a Claude Code session on C:\Development with the catch-up prompt pre-filled - press Enter in the new window to actually start it (Claude Desktop never auto-sends a deep-linked prompt)">
            <StackPanel>
              <TextBlock Text="Dev Catch-Up" FontSize="14" FontWeight="Bold"/>
              <TextBlock Text="Claude Code session, scoped to C:\Development" FontSize="11" Opacity="0.85"/>
            </StackPanel>
          </Button>
          <Button Padding="16,10" Background="#2F9E6F" Foreground="White" BorderThickness="0"
                  Command="{Binding CoworkCatchUpCommand}"
                  ToolTip="Opens a Claude Cowork session with both repos attached, pre-filled to run the brian-catchup skill - press Enter in the new window to send it">
            <StackPanel>
              <TextBlock Text="Cowork Catch-Up" FontSize="14" FontWeight="Bold"/>
              <TextBlock Text="Claude Cowork session, both governance repos attached" FontSize="11" Opacity="0.85"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Row 2+: the domain tree - one level visible at a time -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <Button Content="&lt; Back" Padding="10,4" Margin="0,0,10,0" FontSize="12" Background="#2A3A55" Foreground="White"
                  BorderThickness="0" IsEnabled="{Binding CanGoBack}" Command="{Binding GoBackCommand}"/>
          <TextBlock Text="{Binding BreadcrumbText}" FontSize="13" Foreground="#9FB3C8" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- The currently-open node's own card, if it has any content of its own -->
        <Border Margin="0,0,0,16" Padding="16" Background="#16223A" CornerRadius="10"
                Visibility="{Binding CurrentNode, Converter={StaticResource NotNullToVis}}">
          <StackPanel DataContext="{Binding CurrentNode}">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"/>

            <StackPanel Visibility="{Binding GovernanceProject, Converter={StaticResource NotNullToVis}}" Margin="0,8,0,0">
              <TextBlock Text="{Binding GovernanceProject.Status}" FontSize="12" Foreground="#7FD1AE"/>
              <TextBlock Text="{Binding GovernanceProject.NextAction}" FontSize="12" Foreground="#9FB3C8" Margin="0,4,0,0" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                          Visibility="{Binding GovernanceProject.HasRepoPath, Converter={StaticResource BoolToVis}}">
                <Button Content="Open" Padding="14,6" Margin="0,0,8,0" Background="#2F6FED" Foreground="White" BorderThickness="0"
                        Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding GovernanceProject}"/>
                <Button Content="Develop" Padding="14,6" Background="#3A4A66" Foreground="White" BorderThickness="0"
                        Command="{Binding DataContext.DevelopProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding GovernanceProject}"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding VisibleNodes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="300" Margin="0,0,14,14" Padding="16" Background="#1B2A44" CornerRadius="10">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>

                  <StackPanel Visibility="{Binding GovernanceProject, Converter={StaticResource NotNullToVis}}" Margin="0,8,0,0">
                    <TextBlock Text="{Binding GovernanceProject.Status}" FontSize="12" Foreground="#7FD1AE"/>
                    <TextBlock Text="{Binding GovernanceProject.NextAction}" FontSize="12" Foreground="#9FB3C8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding GovernanceProject.HasRepoPath, Converter={StaticResource BoolToVis}}">
                      <Button Content="Open" Padding="14,6" Margin="0,0,8,0" Background="#2F6FED" Foreground="White" BorderThickness="0"
                              Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding GovernanceProject}"/>
                      <Button Content="Develop" Padding="14,6" Background="#3A4A66" Foreground="White" BorderThickness="0"
                              Command="{Binding DataContext.DevelopProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding GovernanceProject}"/>
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Visibility="{Binding SoftwareProject, Converter={StaticResource NotNullToVis}}" Margin="0,8,0,0">
                    <TextBlock Text="{Binding SoftwareProject.Status}" FontSize="12" Foreground="#7FD1AE"/>
                    <TextBlock Text="{Binding SoftwareProject.CurrentPhase}" FontSize="12" Foreground="#C5D2E0" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SoftwareProject.NextAction}" FontSize="12" Foreground="#9FB3C8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                  </StackPanel>

                  <Border Visibility="{Binding ModuleCard, Converter={StaticResource NotNullToVis}}" Margin="0,8,0,0" Padding="10,8"
                          Background="#16223A" CornerRadius="6" BorderThickness="0,0,0,4"
                          BorderBrush="{Binding ModuleCard.Severity, Converter={StaticResource SeverityToBrush}}">
                    <StackPanel>
                      <TextBlock Text="{Binding ModuleCard.Headline}" FontSize="13" Foreground="#C5D2E0" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding ModuleCard.Detail}" FontSize="11" Foreground="#8FA0B8" Margin="0,4,0,0" TextWrapping="Wrap"
                                 Visibility="{Binding ModuleCard.Detail, Converter={StaticResource NullOrEmptyToVis}}"/>
                      <Button Content="Go deeper" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left" FontSize="11"
                              Background="#3A4A66" Foreground="White" BorderThickness="0"
                              ToolTip="Opens a Claude session pre-scoped to this card's topic"
                              Command="{Binding DataContext.LaunchModuleCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding ModuleCard}"/>
                    </StackPanel>
                  </Border>

                  <TextBlock Text="Module unreachable - is its Docker stack running?" FontSize="12" Foreground="#E05858"
                             Margin="0,8,0,0" TextWrapping="Wrap"
                             Visibility="{Binding ModuleUnreachable, Converter={StaticResource BoolToVis}}"/>

                  <ItemsControl ItemsSource="{Binding RelatedActions}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock FontSize="11" Foreground="#C5D2E0" TextWrapping="Wrap" Margin="0,2,0,0">
                          <Run Text="{Binding Priority}" FontWeight="Bold" Foreground="#E0A458"/>
                          <Run Text=" - "/>
                          <Run Text="{Binding Action}"/>
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="{Binding Node.StubText}" FontSize="12" Foreground="#6B7A90" Margin="0,8,0,0" TextWrapping="Wrap"
                             Visibility="{Binding IsStub, Converter={StaticResource BoolToVis}}"/>

                  <Button Content="View contents -&gt;" Padding="14,6" Margin="0,12,0,0" HorizontalAlignment="Left"
                          Background="#2F6FED" Foreground="White" BorderThickness="0"
                          Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                          Command="{Binding DataContext.SelectNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
